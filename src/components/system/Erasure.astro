---
import Section from "@/components/brand/Section.astro"

// `.erase` once per surface, where something is ending. Two erasures on one
// screen cancel each other and read as texture rather than argument — this is
// the page's one.
---

<Section ground="void">
  <p class="t-label text-signal">The signature material</p>
  <h2 class="t-h2 erase">This heading is being erased.</h2>
  <p class="mute">
    Signal fuchsia is a dark-ground colour. It sets type on VOID and on PAPER,
    and never on FIELD — 2.89:1 there, which no amount of taste fixes.
  </p>
</Section>
