---
import Mark from "@/components/brand/Mark.astro"
import Section from "@/components/brand/Section.astro"
import { Button } from "@/components/ui/button"
import { SOURCE_URL } from "@/lib/links"

// FIELD. The "trusted hosting" argument, which is only worth making in the
// concrete: a machine, in a house, belonging to a person you can write to.
// Nothing here is a shield, a lock or a padlock — the argument is erasure and
// ownership, not armour (DESIGN.md §Do's and Don'ts).
const notes = [
  {
    term: "The hardware",
    body: "A computer in a basement, not in some datacenter. One machine, owned outright, that nobody else can reach.",
  },
  {
    term: "The software",
    body: "Open WebUI and Bifrost, both open source, plus some code written to make them play nice. All of the source code is publically available.",
  },
  {
    term: "Support",
    body: "You write to me, and I write back. No bots, queues, or useless help articles.",
  },
]
---

<Section ground="field" id="who" class="py-14 md:py-24">
  <div class="cols cols-index">
    <div class="flex flex-col gap-4">
      <Mark name="mark" class="w-11" />
      <p class="t-label mute">Who runs it</p>
      <h2 class="t-h2">One person runs this.</h2>
    </div>

    <div class="flex flex-col gap-6">
      <p class="t-lead">
        Not a massive corporation with a headquarters. Obliv1a is
        one person, assembling open-source software into something an ordinary
        person can use without becoming technical to do it. That is the whole
        arrangement.
      </p>

      <dl class="border-t border-(--g-rule)">
        {
          notes.map((note) => (
            <div class="cols cols-index gap-y-2 border-b border-(--g-rule) py-5">
              <dt class="t-label">{note.term}</dt>
              <dd class="t-small mute">{note.body}</dd>
            </div>
          ))
        }
      </dl>

      <div class="flex flex-wrap gap-2">
        <Button href={SOURCE_URL} variant="ghost">Read the source</Button>
      </div>
    </div>
  </div>
</Section>
