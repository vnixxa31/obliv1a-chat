---
import Section from "@/components/brand/Section.astro"

// The honest section. It exists because "auditable over reassuring" is a product
// principle: a limitation the reader finds later reads as something that was
// hidden, and a limitation stated first reads as the reason to believe the rest.
//
// Ruled term-and-body rows, not a grid of icons with headings under them.
const limits = [
  {
    term: "It will be wrong sometimes.",
    body: "This is an AI assistant. Like all AI systems, it may produce biased, inaccurate, or harmful outputs. Always verify critical information independently before relying on it.",
  },
  {
    term: "It is near the frontier, not ahead of it.",
    body: "On the hardest problems it may sit slightly behind the largest models in the world. For most questions on most days, you will not be able to tell.",
  },
  {
    term: "A broken-into account is a readable account.",
    body: "If someone signs in as you, they can read what you saved. Like with any service, always set a strong password.",
  },
]
---

<Section id="limits" class="pt-12 pb-14 md:pt-16 md:pb-24">
  <p class="t-label mute">Before you sign up</p>
  <h2 class="t-h2">The inherent limitations of the service.</h2>

  <dl class="mt-4 border-t border-(--g-rule)">
    {
      limits.map((limit) => (
        <div class="cols cols-index gap-y-2 border-b border-(--g-rule) py-5">
          <dt class="t-h3">{limit.term}</dt>
          <dd class="t-small mute">{limit.body}</dd>
        </div>
      ))
    }
  </dl>
</Section>
