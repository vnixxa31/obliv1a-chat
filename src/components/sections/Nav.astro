---
import Mark from "@/components/brand/Mark.astro"
import Section from "@/components/brand/Section.astro"
import { Button } from "@/components/ui/button"

// The masthead sits on PAPER and is separated by a rule, not a shadow: elevation
// in this system is one 1px line, declared once per surface (DESIGN.md §Elevation).
//
// The lockup carries "Obliv1a" and the product noun is set beside it in the label
// voice. Products are `Obliv1a <Noun>`, never a sub-brand, so "Chat" is a word
// next to the mark rather than a second logo.
const links = [
  { href: "#what", label: "What it is" },
  { href: "#kept", label: "What's kept" },
  { href: "#plans", label: "Plans" },
  { href: "#who", label: "Who runs it" },
]
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:top-(--frame) focus:left-(--frame) focus:z-40 focus:bg-field focus:px-4 focus:py-3 focus:font-mono focus:text-[length:var(--t-label)] focus:tracking-label focus:text-paper focus:uppercase"
  >Skip to content</a
>

<Section width="wide" class="border-b border-(--g-rule) py-5">
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
    <a href="#top" class="flex items-center gap-3 text-field">
      <Mark name="lockup-h" label="Obliv1a" class="w-[150px]" />
      <span class="t-label mute border-l border-(--g-rule) py-1 pl-3">Chat</span
      >
    </a>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <nav class="hidden sm:block" aria-label="Page">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {
            links.map((link) => (
              <li>
                <a class="t-label hover:text-field" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <Button href="#waitlist" size="sm">Join the waitlist</Button>
    </div>
  </div>
</Section>
