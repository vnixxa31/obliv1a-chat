---
import Section from "@/components/brand/Section.astro"

// FIELD. Not one thing below is restyled for it: `.on-field` re-declares the
// variables the rule colours and the muted ink already read, and they invert.
//
// The everyday-use list is ruled rows, not an icon-heading-text grid. The point
// of the section is that this is an ordinary chatbot, and ordinary is a list.
const uses = [
  "Draft the email you have been putting off.",
  "Summarize a long document.",
  "Explain something complicated in plain English.",
  "Plan a week of meals around what is in the fridge.",
  "Talk a problem through, one step at a time.",
]
---

<Section ground="field" id="what" width="wide" class="py-14 md:py-24">
  <div class="cols cols-index">
    <div class="flex flex-col gap-3">
      <p class="t-label mute">What it is</p>
      <h2 class="t-h2">It's a chatbot.</h2>
    </div>

    <div class="flex flex-col gap-6">
      <p class="t-lead">
        You already know how to use it. Whatever you would ask the assistant you
        already use, you can ask this one. There is nothing to install, no
        settings to configure. Type a question, read the answer.
      </p>

      <ul class="grid gap-x-8 sm:grid-cols-2">
        {
          uses.map((use) => (
            <li class="t-small border-t border-(--g-rule) py-3">{use}</li>
          ))
        }
      </ul>

      <p class="t-body">
        It runs on anything: your phone, your laptop, anything with a modern web browser. 
        Your conversations follow you between them seamlessly. A mobile
        app is on the way.
      </p>
    </div>
  </div>
</Section>
