---
import Section from "@/components/brand/Section.astro"
import { Badge } from "@/components/ui/badge"
import { Button } from "@/components/ui/button"
import { SOURCE_URL } from "@/lib/links"

// PAPER is the default ground, so nothing here declares one — :root already
// carries the paper contract.
//
// The right-hand column is a ledger of refusals rather than a stack of feature
// cards: ruled rows, the industry's habit on the left and the same two words
// answering flush right, so the repetition stacks into a column of its own and
// does the work a comparison table usually needs three columns for. Nothing
// floats — the rules are the only elevation, one per row (DESIGN.md §Elevation).
//
// The habits are struck through in the ground's signal, which is the hero's one
// warm note and the system's own argument in miniature: a line cut through a
// form that keeps its shape. `.erase` is not reached for here — Path owns the
// page's one erasure, and two on a screen read as texture.
const habits = [
  "Train on your chats.",
  "Sell what you type to advertisers.",
  "Keep your conversations after you close the account.",
  "Slip ads into the answers.",
  "Treat you as one more user in a giant datacenter.",
]
---

<Section id="top" width="wide" class="py-14 md:py-24">
  <div class="cols cols-side">
    <div class="flex flex-col gap-6">
      <p class="t-label mute">Obliv1a Chat · joining by waitlist</p>
      <h1 class="t-display">The other guys are reading your chats.</h1>
      <h1 class="t-display">We don't.</h1>
      <p class="t-lead">
        Obliv1a Chat is an AI assistant you open in a browser. The conversations
        are stored on one machine, my machine.
      </p>
      <div class="flex flex-wrap gap-2">
        <Button href="#waitlist">Join the waitlist</Button>
        <Button href={SOURCE_URL} variant="ghost">Read the source</Button>
      </div>
      <div class="flex flex-wrap gap-2">
        <Badge>Zero retention</Badge>
        <Badge>Open source</Badge>
        <Badge>Free tier</Badge>
      </div>
    </div>

    <div class="flex flex-col">
      <p class="sr-only">
        What the other guys do with your conversations, and what Obliv1a Chat
        does instead.
      </p>
      <div
        class="flex items-baseline justify-between gap-6 border-b border-(--g-rule-firm) pb-2"
      >
        <p class="t-label mute">The other guys</p>
        <p class="t-label">Obliv1a</p>
      </div>
      <dl>
        {
          habits.map((habit) => (
            <div class="grid grid-cols-[1fr_auto] items-baseline gap-x-6 border-b border-(--g-rule) py-3">
              <dt class="t-small">{habit}</dt>
              <dd class="t-h3 whitespace-nowrap">We don't.</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</Section>
